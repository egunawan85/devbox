{
  "attribution": {
    "commit": ""
  },
  "permissions": {
    "allow": [
      "Bash",
      "Monitor",
      "PowerShell",
      "Read",
      "Grep",
      "Glob",
      "Skill(win-test)",
      "Edit(//**/.git/info/exclude)",
      "Edit(//**/.claude/worktrees/**)"
    ],
    "deny": [
      "Bash(ssh-allow:*)",
      "Bash(~/.claude/scripts/ssh-allow.sh:*)",
      "Bash(*/ssh-allow.sh:*)",
      "PowerShell(ssh-allow:*)",
      "PowerShell(~/.claude/scripts/ssh-allow.sh:*)",
      "PowerShell(*/ssh-allow.sh:*)",
      "Edit(//**/.config/devbox/ssh-allow)",
      "Edit(//**/.claude/settings.json)",
      "Edit(//**/.claude/hooks/**)",
      "Edit(//**/claude-config/settings.json)",
      "Edit(//**/claude-config/hooks/**)",
      "Edit(//**/claude-config/scripts/ssh-allow.sh)",
      "Edit(/tmp/**)",
      "Edit(/var/tmp/**)",
      "Bash(cd)",
      "Bash(cd /*)",
      "Bash(cd ~*)",
      "Bash(cd ..*)",
      "Bash(cd -*)",
      "PowerShell(cd)",
      "PowerShell(cd /*)",
      "PowerShell(cd \\*)",
      "PowerShell(cd *:*)",
      "PowerShell(cd ~*)",
      "PowerShell(cd ..*)",
      "PowerShell(cd -*)",
      "PowerShell(Set-Location)",
      "PowerShell(Set-Location /*)",
      "PowerShell(Set-Location \\*)",
      "PowerShell(Set-Location *:*)",
      "PowerShell(Set-Location ~*)",
      "PowerShell(Set-Location ..*)",
      "PowerShell(Set-Location -*)",
      "PowerShell(sl)",
      "PowerShell(sl /*)",
      "PowerShell(sl \\*)",
      "PowerShell(sl *:*)",
      "PowerShell(sl ~*)",
      "PowerShell(sl ..*)",
      "PowerShell(sl -*)",
      "PowerShell(chdir)",
      "PowerShell(chdir /*)",
      "PowerShell(chdir \\*)",
      "PowerShell(chdir *:*)",
      "PowerShell(chdir ~*)",
      "PowerShell(chdir ..*)",
      "PowerShell(chdir -*)"
    ],
    "ask": [
      "Bash(ssh:*)",
      "Bash(git pull:*)",
      "Bash(git clone:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git revert:*)",
      "Bash(git switch:*)",
      "Bash(git restore:*)",
      "Bash(git mv:*)",
      "Bash(git apply:*)",
      "Bash(git am:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git clean:*)",
      "Bash(git stash:*)",
      "PowerShell(ssh:*)",
      "PowerShell(git pull:*)",
      "PowerShell(git clone:*)",
      "PowerShell(git merge:*)",
      "PowerShell(git rebase:*)",
      "PowerShell(git revert:*)",
      "PowerShell(git switch:*)",
      "PowerShell(git restore:*)",
      "PowerShell(git mv:*)",
      "PowerShell(git apply:*)",
      "PowerShell(git am:*)",
      "PowerShell(git cherry-pick:*)",
      "PowerShell(git clean:*)",
      "PowerShell(git stash:*)"
    ],
    "defaultMode": "acceptEdits"
  },
  "model": "claude-fable-5-1[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/git-write-guard.js\"",
            "shell": "bash",
            "timeout": 15,
            "statusMessage": "Checking git write-guard"
          },
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/ssh-host-guard.js\"",
            "shell": "bash",
            "timeout": 15,
            "statusMessage": "Checking SSH allow list"
          }
        ]
      }
    ]
  },
  "autoUpdatesChannel": "latest",
  "theme": "dark",
  "agentPushNotifEnabled": true
}
